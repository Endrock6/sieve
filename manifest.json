{
  "manifest_version": 3,
  "name": "Sieve",
  "version": "1.0.0",
  "description": "Mint a unique, traceable email alias for the site you are on.",
  "permissions": ["activeTab", "storage", "clipboardWrite"],
  "action": {
    "default_title": "Sieve — generate alias",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
